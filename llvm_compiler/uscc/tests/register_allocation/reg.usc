// reg.usc
// Test for register allocation

int main() {
    int v1 = 10;
    int v2 = 20;
    int v3 = 30;
    int v4 = 40;
    int v5 = 50;
    int v6 = 60;
    int v7 = 70;
    int v8 = 80;

    int result = 0;
    int i = 0;

    while (i < 1) {
        result = v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8;
        
        v1 = v1 + 1;
        v2 = v2 + 1;
        v3 = v3 + 1;
        v4 = v4 + 1;
        v5 = v5 + 1;
        v6 = v6 + 1;
        v7 = v7 + 1;
        v8 = v8 + 1;

        i = i + 1;
    }
    printf("Result: %d\n", result);
    return 0;
}
