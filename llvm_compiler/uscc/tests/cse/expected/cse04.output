; ModuleID = 'main'

@.str = private unnamed_addr constant [8 x i8] c"sum=%d\0A\00"

declare i32 @printf(i8*, ...)

define i32 @main() {
entry:
  br label %while.cond

while.cond:                                       ; preds = %while.body, %entry
  %Phi = phi i32 [ %add4, %while.body ], [ 0, %entry ]
  %Phi3 = phi i32 [ %add, %while.body ], [ 0, %entry ]
  %lt = icmp slt i32 %Phi, 10
  %zext = zext i1 %lt to i32
  %0 = icmp ne i32 %zext, 0
  br i1 %0, label %while.body, label %while.end

while.body:                                       ; preds = %while.cond
  %mul = mul i32 7, 3
  %add = add i32 %Phi3, %mul
  %add4 = add i32 %Phi, 1
  br label %while.cond

while.end:                                        ; preds = %while.cond
  %1 = call i32 (i8*, ...)* @printf(i8* getelementptr inbounds ([8 x i8]* @.str, i32 0, i32 0), i32 %Phi3)
  ret i32 0
}
